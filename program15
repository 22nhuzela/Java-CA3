class Solution {
    public boolean isNumber(String s) {

        boolean digit = false;
        boolean dot = false;
        boolean exp = false;
        boolean number = false;

        for (int i = 0; i < s.length(); i++) {

            char c = s.charAt(i);

            if (c >= '0' && c <= '9') {
                digit = true;
                number = true;
            }

            else if (c == '+' || c == '-') {

                if (i != 0 && s.charAt(i - 1) != 'e'
                            && s.charAt(i - 1) != 'E') {
                    return false;
                }

                number = false;
            }

            else if (c == '.') {

                if (dot || exp) {
                    return false;
                }

                dot = true;
            }

            else if (c == 'e' || c == 'E') {

                if (exp || !digit) {
                    return false;
                }

                exp = true;
                digit = false;
                number = false;
            }

            else {
                return false;
            }
        }

        return number;
    }
}
